# Copy to .env and fill in. The real .env is git-ignored (root .gitignore: `.env`).
# NEVER commit the real .env or print the private key into logs/reports.
#
# Generate a fresh TESTNET-ONLY key with ethers v6:
#   node -e 'const {Wallet}=require("ethers");const w=Wallet.createRandom();console.log("0x"+w.address+"\n"+w.privateKey)'
# Store only in .env. Never use a key that has ever touched mainnet for deploys.

# Fresh testnet-only deployer key (REQUIRED — the baseSepolia network is only
# added to hardhat.config.ts when this is set)
DEPLOYER_PRIVATE_KEY=

# Real Circle USDC on Base Sepolia (chain 84532)
USDC_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Fee recipient for the escrow (any address you control; deployer works for testnet)
TREASURY_ADDRESS=

# Public Base Sepolia RPC (override with your own endpoint if rate-limited)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional — only for scripts/manifest.ts run AFTER an existing deployment
# (scripts/deploy/baseSepolia.ts writes the manifest automatically):
# ESCROW_ADDRESS=
# ESCROW_DEPLOY_TX=
