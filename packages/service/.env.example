# AgentRails escrow service — copy to .env and fill in. NEVER commit .env.

# Private key of the operator wallet. REQUIRED.
# The operator signs every transaction and acts as the buyer (deal creator +
# depositor). In v0 single-operator mode the whole deal lifecycle runs with
# this one key: create deals with seller/verifier set to the operator address.
# Leave this empty here and paste your own key in your local .env only.
# (A well-known Hardhat test key used to sit in this example; it was removed
# so secret scanners do not flag the file. Never hold real funds with a
# published test key.)
OPERATOR_PRIVATE_KEY=

# JSON-RPC endpoint of the chain the Escrow contract lives on. REQUIRED for
# anything other than the in-process hardhat network.
RPC_URL=http://127.0.0.1:8545

# Address of the deployed Escrow contract. REQUIRED.
ESCROW_ADDRESS=

# HTTP port the API listens on (default 3001; port 3000 is the team site).
PORT=3001

# SQLite file for the event indexer (created on boot; directory is made).
# Relative paths resolve against the process working directory.
DB_PATH=data/agentrails.db

# How often the indexer polls for new Escrow events, in milliseconds.
INDEXER_INTERVAL_MS=2000
